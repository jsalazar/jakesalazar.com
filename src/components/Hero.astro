      <section class="p-section-white">
        <div class="container">
          <div class="row align-items-center">
            <div class="col-md-6 px-4 px-lg-0">
              <h1 class="h1-section">Jake is a perpetual student of the Internet.</h1>
              <Img src="jake-salazar-0-sm.jpg" alt="Jake Salazar pondering" class="w-100 cool-pic d-lg-none d-inline-block mb-4" />
              <p class="lead-section pe-0 pe-lg-5">
                He is a full-stack developer who is all about results.
                Creating and writing code truly warms his heart.
                Some consider him Layer 8 of the OSI model, bringing a human touch to 
                a universal computing framework.
              </p>
              <div class="d-flex justify-content-center justify-content-lg-start mt-5">
                <a class="btn btn-cta escrollee" href="#reach-out" role="button">Contact Jake</a>
                <a class="btn ms-sm-0 ms-lg-5 btn-learn escrollee" href="#trusted" role="button">Learn More...</a>
              </div>
            </div>
            <div class="col-md-6 text-center">
              <Img src="jake-salazar-0.jpg" alt="Jake Salazar pondering" class="w-100 cool-pic d-lg-inline-block d-none" />
            </div>
          </div>
        </div>
      </section>


