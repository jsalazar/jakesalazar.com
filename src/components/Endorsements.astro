---
import Img from './Img.astro';
import testimonials from '../data/testimonials.json';
---

<section class="py-3 pb-5 bg-brand-gradient-white-blue">
  <div class="container ">

    <div class="row justify-content-center">
      <div class="col-lg-8 col-sm-12">
        <h3 class="text-center m-0 p-0" style="color: ghostwhite;">Fake</h3> 
        <h2 class="h2-section text-center">Celebrity Endorsements</h2>
        <p class="lead pt-2 pb-4 px-4 px-lg-0 text-center text-muted">
            Movie characters love him. Do you know anyone with this much clout?
        </p>
      </div>
    </div>

    <div id="celebrityCaptions" class="carousel carousel-dark slide" data-bs-ride="carousel">
      
      <div class="carousel-inner">

        {testimonials.map((t, i) => (
          <div class:list={['carousel-item', { active: i === 0 }]}>
            <div class="container">
              <div class="row justify-content-center">
                <div class="col-9 col-lg-7 text-center h-100">
                  <h2 class="carousel-qt mt-5" set:html={`"${t.quote}"`} />
                  <Img src={`testimonials/${t.image}`} alt={t.alt} class="rounded-circle mt-5 w-25" widths={[160, 320]} sizes="160px" />
                  <p class="lead text-muted mt-3"> - {t.name}</p>
                </div>
              </div>
            </div>
          </div>
        ))}

      </div>
      <a class="carousel-control-prev" href="#celebrityCaptions" role="button" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </a>
      <a class="carousel-control-next" href="#celebrityCaptions" role="button" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </a>
    </div>

  </div>
</section>

